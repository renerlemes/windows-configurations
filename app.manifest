<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0"
          xmlns="urn:schemas-microsoft-com:asm.v1">

	<trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
		<security>
			<requestedPrivileges>
				<!--
				O gerenciamento de áudio não precisa de privilégio. Elevar o processo impediria
				a inicialização com o Windows em máquinas gerenciadas, onde o usuário geralmente
				não é administrador local.
				-->
				<requestedExecutionLevel level="asInvoker" uiAccess="false" />
			</requestedPrivileges>
		</security>
	</trustInfo>

</assembly>
